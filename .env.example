# Скопируйте в .env и заполните своими значениями. Файл .env в git не попадает!

# --- Приложение ---
DEBUG=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=food_db
POSTGRES_USER=food_user
POSTGRES_PASSWORD=change_me
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Безопасность ---
# Сгенерируйте реальный секрет и впишите его сюда (команда генерации ниже):
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- CORS (список origin через запятую или JSON-массив) ---
# UI раздаётся самим API (/app) — CORS нужен только для отдельного dev-сервера фронтенда
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Аварийный override URL БД (обычно пусто; например sqlite+aiosqlite:///./dev.db,
#     если нужно поднять приложение без Docker/PostgreSQL) ---
# DATABASE_URL_OVERRIDE=
