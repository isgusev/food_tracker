# Скопируйте в .env и заполните своими значениями. Файл .env в git не попадает!

# --- Приложение ---
DEBUG=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=food_db
POSTGRES_USER=food_user
POSTGRES_PASSWORD=change_me
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Безопасность ---
SECRET_KEY=generate-me-with: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- CORS (список origin через запятую или JSON-массив) ---
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
